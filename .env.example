DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_NAME="Initial Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-unique-password"
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
LOG_FILE=
# Resend is preferred for transactional and notification email.
RESEND_API_KEY=
EMAIL_FROM=
# SMTP remains available as a fallback for existing notification deployments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SIMULATION_UPDATE_INTERVAL_MS=10000
SIMULATION_DEFAULT_SPEED_KPH=35
SIMULATION_MAX_CONCURRENT=20
