// Prisma configuration and database model definitions.
// Each model below becomes a database table, and each relation links related data.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DRIVER
  COMMUTER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
  SUSPENDED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SimulationStatus {
  RUNNING
  STOPPED
  ERROR
}

enum ReportType {
  VEHICLE_UTILIZATION
  DRIVER_PERFORMANCE
  TRIP_COMPLETION
  ROUTE_PERFORMANCE
  TRIP_DELAYS
  VEHICLE_MAINTENANCE
  FLEET_OPERATIONAL
  USER_REGISTRATION
}

enum ReportFormat {
  PDF
  XLSX
  CSV
}

enum ReportStatus {
  COMPLETED
  FAILED
}

model User {
  id                     Int                     @id @default(autoincrement())
  fullName               String                  @db.VarChar(150)
  email                  String                  @unique @db.VarChar(191)
  phoneNumber            String?                 @db.VarChar(30)
  passwordHash           String                  @db.VarChar(255)
  role                   UserRole                @default(COMMUTER)
  status                 UserStatus              @default(PENDING)
  emailVerifiedAt        DateTime?               @default(now())
  verificationEmailSentAt DateTime?
  passwordResetRequestedAt DateTime?
  approvedAt             DateTime?
  approvedById           Int?
  rejectedAt             DateTime?
  rejectedById           Int?
  rejectionReason        String?
  suspendedAt            DateTime?
  suspendedById          Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  driverProfile          DriverProfile?
  drivenTrips            Trip[]                  @relation("TripDriver")
  vehicleAssignments     VehicleAssignment[]     @relation("AssignmentDriver")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  approvedUsers          User[]                  @relation("ApprovedBy")
  approvedBy             User?                   @relation("ApprovedBy", fields: [approvedById], references: [id])
  rejectedUsers          User[]                  @relation("RejectedBy")
  rejectedBy             User?                   @relation("RejectedBy", fields: [rejectedById], references: [id])
  suspendedUsers         User[]                  @relation("SuspendedBy")
  suspendedBy            User?                   @relation("SuspendedBy", fields: [suspendedById], references: [id])
  cancelledTrips         Trip[]                  @relation("TripCancelledBy")
  tripAssignments        TripAssignment[]        @relation("TripAssignmentDriver")
  tripStatusChanges      TripStatusHistory[]     @relation("TripStatusActor")
  refreshTokens          RefreshToken[]
  auditEvents            AuditLog[]              @relation("AuditActor")
  auditTargets           AuditLog[]              @relation("AuditTarget")
  generatedReports       Report[]                @relation("ReportGenerator")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Report {
  id            String       @id @default(cuid())
  type          ReportType
  format        ReportFormat
  status        ReportStatus @default(COMPLETED)
  generatedById Int
  startDate     DateTime?    @db.Date
  endDate       DateTime?    @db.Date
  filters       Json?
  storagePath   String?      @db.VarChar(500)
  fileName      String?      @db.VarChar(255)
  errorMessage  String?
  createdAt     DateTime     @default(now())
  generatedBy   User         @relation("ReportGenerator", fields: [generatedById], references: [id])

  @@index([generatedById, createdAt])
  @@index([type, createdAt])
  @@map("reports")
}

model RefreshToken {
  id                String        @id @default(cuid())
  tokenHash         String        @unique @db.VarChar(64)
  userId            Int
  expiresAt         DateTime
  createdAt         DateTime      @default(now())
  lastUsedAt        DateTime?
  ipAddress         String?       @db.VarChar(64)
  userAgent         String?       @db.VarChar(500)
  revokedAt         DateTime?
  revokedReason     String?       @db.VarChar(100)
  replacedByTokenId String?       @unique
  user              User          @relation(fields: [userId], references: [id])
  replacedBy        RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces          RefreshToken? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model NotificationPreference {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  mutedTypes   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      Int?
  targetUserId Int?
  action       String   @db.VarChar(100)
  resourceType String?  @db.VarChar(100)
  resourceId   String?  @db.VarChar(100)
  metadata     Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(500)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id])

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model DriverProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  licenceNumber String   @unique @db.VarChar(100)
  licenceExpiry DateTime @db.Date
  address       String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@map("driver_profiles")
}

model Vehicle {
  id                  Int                  @id @default(autoincrement())
  registrationNumber  String               @unique @db.VarChar(50)
  vehicleName         String?              @db.VarChar(100)
  manufacturer        String?              @db.VarChar(100)
  model               String?              @db.VarChar(100)
  vehicleType         String               @db.VarChar(50)
  capacity            Int
  manufactureYear     Int?
  description         String?
  status              VehicleStatus        @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trips               Trip[]
  assignments         VehicleAssignment[]
  locations           VehicleLocation[]
  maintenanceRecords  MaintenanceRecord[]
  tripAssignments     TripAssignment[]
  trackingSimulations TrackingSimulation[]

  @@index([status])
  @@map("vehicles")
}

model Route {
  id                Int         @id @default(autoincrement())
  name              String      @db.VarChar(150)
  routeCode         String?     @unique @db.VarChar(50)
  origin            String      @db.VarChar(150)
  destination       String      @db.VarChar(150)
  originStopId      Int?
  destinationStopId Int?
  description       String?
  distanceKm        Decimal?    @db.Decimal(10, 2)
  estimatedDuration Int?
  status            RouteStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  originStop        Stop?       @relation("RouteOriginStop", fields: [originStopId], references: [id], onDelete: Restrict)
  destinationStop   Stop?       @relation("RouteDestinationStop", fields: [destinationStopId], references: [id], onDelete: Restrict)
  routeStops        RouteStop[]
  schedules         Schedule[]
  trips             Trip[]

  @@index([status])
  @@index([originStopId])
  @@index([destinationStopId])
  @@map("routes")
}

model Stop {
  id                Int         @id @default(autoincrement())
  name              String      @db.VarChar(150)
  description       String?
  latitude          Decimal     @db.Decimal(10, 7)
  longitude         Decimal     @db.Decimal(10, 7)
  createdAt         DateTime    @default(now())
  originRoutes      Route[]     @relation("RouteOriginStop")
  destinationRoutes Route[]     @relation("RouteDestinationStop")
  routeStops        RouteStop[]

  @@map("stops")
}

model RouteStop {
  id                        Int   @id @default(autoincrement())
  routeId                   Int
  stopId                    Int
  sequence                  Int
  estimatedMinutesFromStart Int?
  route                     Route @relation(fields: [routeId], references: [id])
  stop                      Stop  @relation(fields: [stopId], references: [id])

  @@unique([routeId, sequence])
  @@index([routeId, stopId])
  @@map("route_stops")
}

model Schedule {
  id                Int            @id @default(autoincrement())
  routeId           Int
  description       String?
  departureTime     DateTime       @db.Time(0)
  estimatedDuration Int
  effectiveFrom     DateTime       @db.Date
  effectiveUntil    DateTime?      @db.Date
  status            ScheduleStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  route             Route          @relation(fields: [routeId], references: [id])
  days              ScheduleDay[]
  trips             Trip[]

  @@index([routeId, departureTime, status])
  @@index([status, effectiveFrom, effectiveUntil])
  @@map("schedules")
}

model ScheduleDay {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  dayOfWeek  DayOfWeek
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("schedule_days")
}

model Trip {
  id                 Int                 @id @default(autoincrement())
  tripCode           String?             @unique @db.VarChar(50)
  scheduleId         Int
  routeId            Int
  vehicleId          Int?
  driverId           Int?
  scheduledDeparture DateTime
  scheduledArrival   DateTime
  actualDeparture    DateTime?
  actualArrival      DateTime?
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      Int?
  delayReason        String?
  revisedDeparture   DateTime?
  revisedArrival     DateTime?
  status             TripStatus          @default(SCHEDULED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  schedule           Schedule            @relation(fields: [scheduleId], references: [id])
  route              Route               @relation(fields: [routeId], references: [id])
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id])
  driver             User?               @relation("TripDriver", fields: [driverId], references: [id])
  cancelledBy        User?               @relation("TripCancelledBy", fields: [cancelledById], references: [id])
  locations          VehicleLocation[]
  tripAssignments    TripAssignment[]
  statusHistory      TripStatusHistory[]
  trackingSimulation TrackingSimulation?

  @@unique([scheduleId, scheduledDeparture])
  @@index([driverId])
  @@index([vehicleId])
  @@index([routeId])
  @@index([status])
  @@index([scheduledDeparture])
  @@map("trips")
}

model TripAssignment {
  id         Int       @id @default(autoincrement())
  tripId     Int
  driverId   Int
  vehicleId  Int
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  trip       Trip      @relation(fields: [tripId], references: [id])
  driver     User      @relation("TripAssignmentDriver", fields: [driverId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([tripId, assignedAt])
  @@index([driverId, endedAt])
  @@index([vehicleId, endedAt])
  @@map("trip_assignments")
}

model TripStatusHistory {
  id          String      @id @default(cuid())
  tripId      Int
  fromStatus  TripStatus?
  toStatus    TripStatus
  changedById Int?
  reason      String?
  createdAt   DateTime    @default(now())
  trip        Trip        @relation(fields: [tripId], references: [id])
  changedBy   User?       @relation("TripStatusActor", fields: [changedById], references: [id])

  @@index([tripId, createdAt])
  @@index([changedById, createdAt])
  @@map("trip_status_history")
}

model VehicleAssignment {
  id         Int       @id @default(autoincrement())
  vehicleId  Int
  driverId   Int
  assignedAt DateTime
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  driver     User      @relation("AssignmentDriver", fields: [driverId], references: [id])

  @@index([vehicleId, endedAt])
  @@index([driverId, endedAt])
  @@map("vehicle_assignments")
}

model VehicleLocation {
  id          BigInt   @id @default(autoincrement())
  vehicleId   Int
  tripId      Int?
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  speed       Decimal? @db.Decimal(6, 2)
  heading     Decimal? @db.Decimal(6, 2)
  isSimulated Boolean  @default(true)
  recordedAt  DateTime
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  trip        Trip?    @relation(fields: [tripId], references: [id])

  @@index([vehicleId, recordedAt])
  @@index([tripId])
  @@index([tripId, recordedAt])
  @@map("vehicle_locations")
}

model TrackingSimulation {
  id           String           @id @default(cuid())
  tripId       Int              @unique
  vehicleId    Int
  status       SimulationStatus @default(RUNNING)
  startedAt    DateTime         @default(now())
  stoppedAt    DateTime?
  stopReason   String?          @db.VarChar(100)
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  trip         Trip             @relation(fields: [tripId], references: [id])
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id])

  @@index([status, startedAt])
  @@index([vehicleId, status])
  @@map("tracking_simulations")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String    @db.VarChar(150)
  message   String
  type      String    @db.VarChar(50)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  dedupeKey String?   @unique @db.VarChar(191)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model MaintenanceRecord {
  id              Int               @id @default(autoincrement())
  vehicleId       Int
  description     String
  maintenanceDate DateTime          @db.Date
  cost            Decimal?          @db.Decimal(10, 2)
  status          MaintenanceStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, maintenanceDate])
  @@map("maintenance_records")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String?
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
