{
  "info": {
    "name": "Smart Transport - Phase 5 Dashboard and Reports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "reportId", "value": "" }
  ],
  "item": [
    {
      "name": "Dashboard overview",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/dashboard/overview" }
    },
    {
      "name": "Trip analytics (custom range)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/dashboard/trips?startDate=2026-11-01&endDate=2026-11-30" }
    },
    {
      "name": "Driver performance",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/analytics/drivers?period=last30days" }
    },
    {
      "name": "Generate XLSX trip report",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reportType\": \"TRIP_COMPLETION\",\n  \"format\": \"XLSX\",\n  \"period\": \"last30days\"\n}" }, "url": "{{baseUrl}}/admin/reports/generate" }
    },
    {
      "name": "List reports",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/reports" }
    },
    {
      "name": "Download report",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/admin/reports/{{reportId}}/download" }
    }
  ]
}
